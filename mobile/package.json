{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export",
    "type-check": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:flows": "jest src/__tests__/flows",
    "test:screens": "jest src/screens/**/__tests__",
    "test:critical": "playwright test --config=playwright.config.critical.ts",
    "test:critical:ui": "playwright test --config=playwright.config.critical.ts --ui",
    "test:unit:typography": "jest Typography.test.tsx --no-coverage",
    "test:e2e": "maestro test --config e2e/config/maestro.yaml e2e/flows/",
    "test:e2e:smoke": "maestro test --config e2e/config/maestro.yaml e2e/flows/smoke-test.yaml",
    "test:e2e:auth": "maestro test --config e2e/config/maestro.yaml e2e/flows/auth/",
    "test:e2e:consumer": "maestro test --config e2e/config/maestro.yaml e2e/flows/consumer/",
    "test:e2e:merchant": "maestro test --config e2e/config/maestro.yaml e2e/flows/merchant/",
    "test:e2e:watch": "maestro studio",
    "test:e2e:record": "maestro test --config e2e/config/maestro.yaml --record e2e/flows/",
    "test:detox": "detox test --configuration android.emu.debug",
    "test:detox:android": "detox test --configuration android.att.debug",
    "test:detox:ios": "detox test --configuration ios.sim.debug",
    "test:detox:build:android": "detox build --configuration android.emu.debug",
    "test:detox:build:ios": "detox build --configuration ios.sim.debug",
    "test:integration": "jest --testPathPattern=integration.test.ts",
    "prepare": "husky",
    "device:check": "tsx scripts/check-device.ts",
    "device:wait": "tsx scripts/wait-for-device.ts",
    "emulator:start": "scripts\\start-emulator.bat",
    "test:app:full": "tsx scripts/app-tester.ts",
    "test:app:consumer": "tsx scripts/app-tester.ts --scenario=consumer",
    "test:app:merchant": "tsx scripts/app-tester.ts --scenario=merchant",
    "screenshots:resize": "python scripts/resize-screenshots.py",
    "report:generate": "tsx scripts/generate-report.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@maplibre/maplibre-react-native": "^10.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "^8.4.5",
    "@react-native-community/netinfo": "11.4.1",
    "@react-native-firebase/app": "^23.7.0",
    "@react-native-firebase/auth": "^23.7.0",
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.26",
    "@reduxjs/toolkit": "^2.9.0",
    "@sentry/react-native": "^7.7.0",
    "@shopify/flash-list": "^2.0.2",
    "@types/lodash": "^4.17.21",
    "axios": "^1.12.2",
    "date-fns": "^4.1.0",
    "expo": "54.0.13",
    "expo-asset": "^12.0.9",
    "expo-build-properties": "^1.0.9",
    "expo-constants": "~18.0.9",
    "expo-dev-client": "~6.0.20",
    "expo-device": "^8.0.9",
    "expo-file-system": "^19.0.17",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.8",
    "expo-image": "^3.0.9",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "^15.0.7",
    "expo-localization": "~17.0.8",
    "expo-location": "~19.0.7",
    "expo-notifications": "^0.32.12",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "^14.0.7",
    "expo-status-bar": "~3.0.8",
    "expo-updates": "^29.0.12",
    "firebase": "^12.6.0",
    "lodash": "^4.17.21",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-chart-kit": "^6.12.0",
    "react-native-keyboard-aware-scroll-view": "^0.9.5",
    "react-native-maps": "^1.26.17",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-redux": "^9.2.0",
    "socket.io-client": "^4.7.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "@types/react-test-renderer": "^19.1.0",
    "@types/redux-mock-store": "^1.5.0",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "axios-mock-adapter": "^2.1.0",
    "babel-preset-expo": "^54.0.3",
    "eslint": "^9.13.0",
    "eslint-plugin-jest": "^28.2.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.12",
    "mobile-mcp": "^0.0.7",
    "playwright": "^1.56.0",
    "react-test-renderer": "^19.1.0",
    "redux-mock-store": "^1.5.5",
    "redux-thunk": "^3.1.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
