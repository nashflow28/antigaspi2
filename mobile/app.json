{
  "expo": {
    "name": "GÊLADAL",
    "slug": "geladal",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#fad02c"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "enabled": true,
      "checkAutomatically": "ON_LOAD"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.geladal.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "GÊLADAL a besoin d'accéder à votre caméra pour scanner les codes QR",
        "NSLocationWhenInUseUsageDescription": "GÊLADAL a besoin d'accéder à votre position pour vous montrer les commerces proches",
        "NSPhotoLibraryUsageDescription": "GÊLADAL a besoin d'accéder à vos photos pour les avis produits"
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fad02c"
      },
      "package": "com.geladal.app",
      "versionCode": 1,
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#fad02c",
          "sounds": [],
          "defaultChannel": "default"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permettre à GÊLADAL d'accéder à votre position pour trouver les commerces proches."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "usesCleartextTraffic": false
          }
        }
      ],
      "expo-localization",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "@sentry/react-native",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "apiUrl": "https://antigaspi.jubtek.com/api",
      "testMode": false,
      "sentryDsn": "",
      "eas": {
        "projectId": "157d93a5-c53a-4e78-9351-364849a645f7"
      }
    },
    "scheme": "geladal",
    "owner": "nashflow"
  }
}
