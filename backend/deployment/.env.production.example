# ============================================
# ANTIGASPI - Configuration Production VPS
# ============================================
# Copier ce fichier vers .env et remplir avec les vraies valeurs

# ============================================
# APPLICATION
# ============================================
APP_NAME="Antigaspi"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.antigaspi.tg

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ============================================
# LOGGING
# ============================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ============================================
# BASE DE DONNÉES
# ============================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=antigaspi_production
DB_USERNAME=antigaspi_user
DB_PASSWORD=REMPLACER_PAR_MOT_DE_PASSE_FORT

# ============================================
# JWT AUTHENTICATION
# ============================================
# Générer avec: php artisan jwt:secret
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

# ============================================
# SESSION & CACHE
# ============================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
CACHE_PREFIX=

# ============================================
# REDIS (optionnel pour cache performant)
# ============================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================
# QUEUE (pour jobs asynchrones)
# ============================================
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# ============================================
# MAIL (pour notifications)
# ============================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=votre-email@gmail.com
MAIL_PASSWORD=votre-mot-de-passe-app
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@antigaspi.tg"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================
# SMS NOTIFICATIONS (Vonage/Twilio)
# ============================================
VONAGE_KEY=
VONAGE_SECRET=
VONAGE_SMS_FROM="Antigaspi"

# ============================================
# PUSH NOTIFICATIONS (Web Push)
# ============================================
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT="mailto:support@antigaspi.tg"
WEB_PUSH_TTL=900

EXPO_ACCESS_TOKEN=

# ============================================
# STOCKAGE FICHIERS
# ============================================
FILESYSTEM_DISK=local
# Pour stockage cloud (optionnel):
# FILESYSTEM_DISK=s3

# AWS S3 / DigitalOcean Spaces (optionnel)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ============================================
# CORS (Cross-Origin Resource Sharing)
# ============================================
FRONTEND_URL=https://antigaspi.tg

# ============================================
# PAIEMENTS MOBILES (Afrique de l'Ouest)
# ============================================
# FedaPay (Togo, Bénin)
FEDAPAY_PUBLIC_KEY=
FEDAPAY_SECRET_KEY=
FEDAPAY_ENVIRONMENT=live

# CinetPay (Multi-pays)
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET_KEY=

# Paystack (Nigeria, Ghana)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# ============================================
# SEARCH (Meilisearch - optionnel)
# ============================================
SCOUT_DRIVER=meilisearch
SCOUT_QUEUE=true
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=null

# ============================================
# VITE (pour assets frontend - si utilisé)
# ============================================
VITE_APP_NAME="${APP_NAME}"
